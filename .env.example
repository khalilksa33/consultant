HOSTINGER_FTP_SERVER=your-hostinger-ftp-host
HOSTINGER_FTP_USERNAME=your-ftp-user
HOSTINGER_FTP_PASSWORD=your-ftp-password
HOSTINGER_REMOTE_DIR=/public_html/consultant

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USERNAME=hello@yourdomain.com
SMTP_PASSWORD=your-smtp-password
SMTP_ENCRYPTION=tls
SMTP_FROM_EMAIL=hello@yourdomain.com
SMTP_FROM_NAME=Your App

ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=your-admin-password
APP_BASE_URL=https://www.yourdomain.com/consultant
COOKIE_VALIDATION_KEY=replace-with-a-long-random-string
YII_ENV=prod
